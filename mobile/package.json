{
  "name": "training-studio-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@better-auth/expo": "1.7.7",
    "@noble/hashes": "2.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "better-auth": "1.7.7",
    "expo": "~57.0.27",
    "expo-constants": "57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "57.0.12",
    "expo-network": "57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "~19.2.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go",
    "start:grizzly": "node scripts/run-grizzly.mjs start --go",
    "export:grizzly": "node scripts/run-grizzly.mjs export --clear --platform ios --platform android --output-dir dist-grizzly",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check": "tsc --noEmit",
    "test:engine": "node --import tsx scripts/check-engine.ts",
    "sync:shared": "node scripts/sync-shared.mjs",
    "export:mobile": "expo export --clear --platform ios --platform android --output-dir dist-mobile",
    "export:web": "expo export --platform web --output-dir dist-web"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
