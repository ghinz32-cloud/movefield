{
  "name": "training-studio-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.27",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "~19.2.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go",
    "start:dev": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "check": "tsc --noEmit",
    "test:engine": "node --import tsx scripts/check-engine.ts",
    "sync:shared": "node scripts/sync-shared.mjs",
    "export:mobile": "expo export --platform ios --platform android --output-dir dist-mobile",
    "export:web": "expo export --platform web --output-dir dist-web"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
