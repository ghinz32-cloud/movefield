// Owner-reviewed local-first prototype on the account's included workers.dev URL.
// Copy to an ignored local configuration and fill the Account ID before use.
// This file creates no resources and contains no credentials or deployment command.
{
  "name": "movefield-prototype",
  "main": "dist/server/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{"type":"ESModule","globs":["**/*.js","**/*.mjs"]}],
  "assets": {"directory":"dist/client"},
  "workers_dev": true,
  "observability": {"enabled":false},
  "vars": {
    "MOVEFIELD_CLOUD_ENABLED":"false",
    "FREE_ALLOWANCE_VERIFIED":"false",
    "AI_PROVIDER_VERIFIED":"false",
    "NATIVE_AUTH_VERIFIED":"false"
  }
}
